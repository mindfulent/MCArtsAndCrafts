# Packwiz binary
packwiz.exe
packwiz

# Exported modpacks (can be regenerated)
*.mrpack
*.zip

# Build outputs from scripts/build-variants.py
dist/

# But DO track shaderpacks (they are bundled with the modpack)
!shaderpacks/*.zip
# mrpack4server deployment files
mrpack4server*.jar
local.mrpack

# Windows artifacts
nul

# IDE
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]

# Environment variables (contains secrets)
.env
.env.local

# Sensitive configs (contains bot tokens)
config/discord-mc-chat/discord-mc-chat.json

# Claude Code
CLAUDE.md
.claude/

# Downloaded mod jars (should be fetched from Modrinth)
SimpleDiscordLink-*.jar

# Backups
backup_*/

# Distant Horizons LOD cache (large binary, hosted externally)
DistantHorizons.sqlite
